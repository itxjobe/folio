{
  "$schema": "https://folio.mccal.dev/schema/v1/manifest.schema.json",
  "format": 1,
  "id": "com.mccal.folio.theme.tinted",
  "name": "Tinted theme",
  "version": "1.0.0",
  "author": {
    "name": "Folio",
    "url": "https://github.com/McCal-Codes/folio"
  },
  "minFolio": "0.7.0",
  "section": "themes",
  "kind": [
    "theme"
  ],
  "permissions": [
    "home.appearance",
    "icons"
  ],
  "screens": [
    "cover",
    "inner"
