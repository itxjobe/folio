{
  "$schema": "https://folio.mccal.dev/schema/v1/manifest.schema.json",
  "format": 1,
  "id": "com.mccal.folio.colored-albums",
  "name": "Colored Albums",
  "version": "1.0.0",
  "author": {
    "name": "Folio",
    "url": "https://github.com/McCal-Codes/folio"
  },
  "minFolio": "0.7.0",
  "section": "tweaks",
  "kind": [
    "tweakBundle"
  ],
  "permissions": [
    "tweaks"
